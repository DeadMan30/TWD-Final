{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-win64",
      "displayName": "Windows x64 (Host Verification)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-win64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (NDK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
